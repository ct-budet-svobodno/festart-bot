# --- Telegram ---
# Токен от @BotFather. НИКОМУ не пересылать, в git не коммитить.
BOT_TOKEN=
# Юзернейм бота без @ — из него собираются ссылки в QR-кодах
BOT_USERNAME=Festart_bot

# Постоянные суперадмины: Telegram ID через запятую.
# Получают доступ к /admin автоматически, отключить их из бота нельзя —
# это страховка на случай, если приглашения протухли или база пересоздана.
# Свой ID можно узнать командой /id в боте.
ADMIN_TG_IDS=

# --- База данных ---
# Разработка (по умолчанию): SQLite, файл в data/festart.db
DATABASE_URL=sqlite+aiosqlite:///data/festart.db
# Прод: раскомментировать и заполнить
# DATABASE_URL=postgresql+asyncpg://festart:PASSWORD@localhost:5432/festart

# --- Админка ---
# Пароль для входа в веб-панель. Обязательно сменить перед боевым запуском.
ADMIN_PASSWORD=changeme
# Случайная строка для подписи сессий. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000
# Внешний адрес админки — используется в ссылках-приглашениях для организаторов
ADMIN_BASE_URL=http://localhost:8000

# --- Прочее ---
TIMEZONE=Europe/Moscow
